{
  "name": "@mailhelper/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Synthèse des courriels récents et réponses préparées",
  "author": "Gregoire Chevalier",
  "type": "module",
  "scripts": {
    "build": "tsdown && vite build && node scripts/ecrire-le-manifeste.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm build && electron dist",
    "package:windows": "pnpm build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@mailhelper/application": "workspace:*",
    "@mailhelper/domain": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "tsdown": "0.23.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
